# Variáveis do módulo de notificação Zabbix.
# O NetBox e os testes live leem o .env da raiz do repositório: copie estas linhas para lá
# (o .env.example da raiz já as contém).
# Coloque entre aspas simples os valores com espaços, $, aspas ou outros caracteres especiais.

# URL do frontend do Zabbix (ou o .../api_jsonrpc.php completo).
NBC_ZBX_URL=https://zabbix.exemplo.com.br
# Token de API: Users -> API tokens. O usuário precisa ter acesso aos hosts dos equipamentos.
NBC_ZBX_TOKEN=
# Só para os testes live: verificação TLS (caminho de um certificado de CA); padrão: CAs do
# sistema.
# NBC_ZBX_VERIFY=
# Só para os testes live: um host vinculado ao template contrib/zabbix_template.yaml.
NBC_ZBX_TEST_HOST=
# Só para os testes live, opcional: host[:porta] de um Zabbix server ou proxy, para testar
# também o transporte trapper.
NBC_ZBX_TRAPPER=
