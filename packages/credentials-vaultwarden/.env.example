# Variáveis do módulo de credenciais Vaultwarden.
# O NetBox e os testes live leem o .env da raiz do repositório: copie estas linhas para lá
# (o .env.example da raiz já as contém).
# Coloque entre aspas simples os valores com espaços, $, aspas ou outros caracteres especiais:
# 'p#ss$word'

# URL do Vaultwarden.
NBC_VW_URL=https://vault.exemplo.com.br
# Chave de API da conta: cofre web -> Configurações da conta -> Segurança -> Chaves ->
# Ver chave de API.
NBC_VW_CLIENT_ID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NBC_VW_CLIENT_SECRET=
# E-mail e senha mestra da conta, usados para descriptografar o cofre.
NBC_VW_EMAIL=
NBC_VW_MASTER_PASSWORD=
# Verificação TLS: caminho de um certificado de CA (ex.: CA própria do Vaultwarden).
# Não deixe a variável vazia: um valor vazio desativa a verificação. Comente a linha para usar
# as CAs do sistema.
# NBC_VW_VERIFY=/caminho/para/ca.crt
# Só para os testes live: nome de um item Login que existe no cofre.
NBC_VW_TEST_ITEM=
