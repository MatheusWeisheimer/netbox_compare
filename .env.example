# Copie para .env (ignorado pelo git) e preencha.
# Este é o arquivo lido pelo configuration.py do NetBox (contrib/netbox_configuration_snippet.py)
# e pelos testes live (`set -a; . ./.env; set +a; uv run pytest -m live`).
# Ele reúne as variáveis de todos os pacotes; cada pacote que usa variáveis tem o seu próprio
# .env.example com a mesma parte, documentada no README do pacote.
# Coloque entre aspas simples os valores com espaços, $, aspas ou outros caracteres especiais:
# 'p#ss$word'

# --- Vaultwarden (packages/credentials-vaultwarden) ---------------------------------------
# URL do Vaultwarden.
NBC_VW_URL=https://vault.exemplo.com.br
# Chave de API da conta: cofre web -> Configurações da conta -> Segurança -> Chaves ->
# Ver chave de API.
NBC_VW_CLIENT_ID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NBC_VW_CLIENT_SECRET=
# E-mail e senha mestra da conta, usados para descriptografar o cofre.
NBC_VW_EMAIL=
NBC_VW_MASTER_PASSWORD=
# Verificação TLS: caminho de um certificado de CA (ex.: CA própria do Vaultwarden).
# Não deixe a variável vazia: um valor vazio desativa a verificação. Comente a linha para usar
# as CAs do sistema.
# NBC_VW_VERIFY=/caminho/para/ca.crt
# Só para os testes live: nome de um item Login que existe no cofre.
NBC_VW_TEST_ITEM=

# --- Zabbix (packages/notification-zabbix) ------------------------------------------------
# URL do frontend do Zabbix (ou o .../api_jsonrpc.php completo).
NBC_ZBX_URL=https://zabbix.exemplo.com.br
# Token de API: Users -> API tokens. O usuário precisa ter acesso aos hosts dos equipamentos.
NBC_ZBX_TOKEN=
# Só para os testes live: verificação TLS (caminho de um certificado de CA); padrão: CAs do
# sistema.
# NBC_ZBX_VERIFY=
# Só para os testes live: um host vinculado ao template contrib/zabbix_template.yaml.
NBC_ZBX_TEST_HOST=
# Só para os testes live, opcional: host[:porta] de um Zabbix server ou proxy, para testar
# também o transporte trapper.
NBC_ZBX_TRAPPER=
