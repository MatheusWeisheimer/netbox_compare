# Copy to .env (git-ignored) and fill in. Read by NetBox's configuration.py and by the live tests.
# Wrap values with spaces, $, quotes or other special characters in single quotes: 'p#ss$word'
# API key: Vaultwarden web vault -> Account settings -> Security -> Keys -> View API key.
NBC_VW_URL=https://localhost:8443
NBC_VW_CLIENT_ID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NBC_VW_CLIENT_SECRET=
NBC_VW_EMAIL=
NBC_VW_MASTER_PASSWORD=
NBC_VW_VERIFY=/caminho/para/ca.crt
# Only for `uv run pytest -m live`: name of an existing Login item
NBC_VW_TEST_ITEM=
